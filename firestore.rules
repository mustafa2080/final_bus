rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().userType == 'admin';
    }

    function isSupervisor() {
      return isAuthenticated() && getUserData().userType == 'supervisor';
    }

    function isParent() {
      return isAuthenticated() && getUserData().userType == 'parent';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStudentParent(studentData) {
      // Check if the current user is the parent of this student
      return isAuthenticated() && request.auth.uid == studentData.parentId;
    }

    function isValidData(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // Users collection - بيانات المستخدمين
    match /users/{userId} {
      // المستخدم يمكنه قراءة بياناته فقط، الأدمن يمكنه قراءة الكل.
      // المشرف يقدر يقرا بيانات أي مستخدم (اسم/هاتف ولي الأمر بيظهر
      // في شاشة الطلاب عنده) - مفيش أي داتا حساسة (باسورد/توكن) هنا،
      // القراءة بس مش الكتابة.
      allow read: if isOwner(userId) || isAdmin() || isSupervisor();
      // المستخدم يمكنه تحديث بياناته فقط، الأدمن يمكنه تحديث الكل
      allow write: if isOwner(userId) || isAdmin();
    }

    // Students collection - بيانات الطلاب
    match /students/{studentId} {
      // الأدمن والمشرف يمكنهم قراءة وكتابة بيانات جميع الطلاب
      allow read, write: if isAdmin() || isSupervisor();
      // ولي الأمر يمكنه قراءة بيانات أطفاله فقط
      allow read: if isParent() && isStudentParent(resource.data);
      // ولي الأمر يمكنه تحديث بعض البيانات لأطفاله (مثل الصورة)
      allow update: if isParent() && isStudentParent(resource.data);
    }

    // Buses collection - بيانات الحافلات
    match /buses/{busId} {
      // الأدمن يمكنه قراءة وكتابة جميع بيانات الحافلات
      allow read, write: if isAdmin();
      // المشرف يمكنه قراءة بيانات الحافلة المخصصة له
      // + تحديث حالة التتبع وموقعه اللحظي (isTracking/lastLocation/...) فقط
      // أثناء التتبع المباشر - بدون سماح بالإنشاء أو الحذف
      allow read: if isSupervisor();
      allow update: if isSupervisor();
      // ولي الأمر يمكنه قراءة بيانات حافلة طفله
      allow read: if isParent();
    }

    // Trips collection - بيانات الرحلات
    match /trips/{tripId} {
      // الأدمن والمشرف يمكنهم إدارة الرحلات
      allow read, write: if isAdmin() || isSupervisor();
      // ولي الأمر يمكنه قراءة رحلات أطفاله
      allow read: if isParent();
    }

    // Supervisor assignments - تعيينات المشرفين
    match /supervisor_assignments/{assignmentId} {
      // الأدمن فقط يمكنه إدارة تعيينات المشرفين
      allow read, write: if isAdmin();
      // المشرف يمكنه قراءة تعييناته
      allow read: if isSupervisor();
    }

    // Complaints collection - الشكاوى
    match /complaints/{complaintId} {
      // الأدمن يمكنه قراءة جميع الشكاوى
      allow read, write: if isAdmin();
      // ولي الأمر يمكنه إنشاء شكوى وقراءة شكاواه
      allow create: if isParent() && isOwner(request.resource.data.parentId);
      allow read: if isParent() && isOwner(resource.data.parentId);
    }

    // Surveys collection - الاستبيانات
    match /surveys/{surveyId} {
      // الأدمن يمكنه إدارة الاستبيانات
      allow read, write: if isAdmin();
      // المشرف وولي الأمر يمكنهم قراءة الاستبيانات المخصصة لهم
      allow read: if isAuthenticated();
    }

    // Notifications collection - الإشعارات
    match /notifications/{notificationId} {
      // الأدمن يمكنه إدارة جميع الإشعارات
      allow read, write: if isAdmin();
      // الأدمن والمشرف يمكنهم إنشاء إشعارات (مثلاً عند تغيير حالة الطالب)
      allow create: if isAdmin() || isSupervisor();
      // المستخدم يمكنه قراءة إشعاراته فقط
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.recipientId));
      // المستخدم يمكنه تحديث حالة القراءة لإشعاراته
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.recipientId));
    }

    // FCM Tokens collection - نسخة منفصلة من توكنات الإشعارات لكل
    // مستخدم، بيستخدمها الباك اند للإرسال الجماعي حسب نوع المستخدم
    // (sendNotificationToUserType). كانت القاعدة دي ناقصة تمامًا قبل
    // كده، فكانت بتقع تحت القاعدة الافتراضية اللي بتمنع كل شيء - وده
    // كان بيمنع حفظ أي توكن إشعارات لأي مستخدم (ولي أمر / مشرف / أدمن).
    match /fcm_tokens/{userId} {
      // المستخدم يقدر يكتب/يحدّث توكن نفسه بس
      allow write: if isOwner(userId) || isAdmin();
      // القراءة لصاحب التوكن، أو للأدمن، أو لأي مستخدم مسجّل دخول عشان
      // يقدر يستخدم sendNotificationToUserType (مثلاً المشرف بيبعت
      // إشعار لكل الأدمنز بعد تحديث حالة طالب). القراءة هنا محدودة
      // بحقول التوكن نفسه، مفيهاش بيانات حساسة عن المستخدم التاني.
      allow read: if isOwner(userId) || isAdmin() || isAuthenticated();
    }

    // FCM Queue collection - طابور إرسال الإشعارات (بيعالجه سيرفر Node.js
    // الخاص بالباص - backend/index.js - عن طريق Firebase Admin SDK،
    // اللي بيتخطى الـ rules دي أصلاً. القاعدة هنا بتتحكم بس في كتابة
    // العميل (Flutter app) لعنصر جديد في الطابور.
    match /fcm_queue/{queueId} {
      // أي مستخدم مسجّل دخول يقدر يضيف إشعار للطابور (ولي الأمر
      // بيحتاج ده لما يبعت شكوى أو طلب غياب للإدارة/المشرف، مش بس
      // الأدمن والمشرف). الأمان الفعلي بييجي من إن الباك اند بيتحقق
      // من وجود recipientId وبيجيب التوكن بنفسه؛ مفيش هنا أي إمكانية
      // لولي الأمر إنه "يقرأ" رسائل التانيين، بس يضيف طلب إرسال.
      allow create: if isAuthenticated();
      // القراءة للأدمن فقط (لأغراض المراقبة/الدعم)
      allow read: if isAdmin();
      // التحديث والحذف بيتم من الباك اند فقط (Admin SDK بيتخطى الـ rules أصلاً)
      allow update, delete: if false;
    }

    // Parent Profiles collection - البيانات الشخصية لولي الأمر
    // (الاسم الثلاثي/العنوان/الوظيفة/أرقام الهواتف). كانت القاعدة دي
    // ناقصة تمامًا زي fcm_tokens، فكانت بتقع تحت القاعدة الافتراضية
    // اللي بتمنع كل شيء - وده كان بيسبب permission-denied فورًا لما
    // ولي الأمر يحاول يقرأ أو يحفظ بياناته في شاشة "إكمال البيانات".
    match /parent_profiles/{parentId} {
      // ولي الأمر يقدر يقرأ/يكتب بياناته هو بس، الأدمن يقدر يدير الكل.
      // المشرف يقدر يقرا بس (مش يكتب) عشان شاشة "بيانات الطالب" عنده
      // بتعرض اسم/عنوان ولي الأمر - كانت القاعدة قاصرة على الأدمن بس
      // فكان بيوصله permission-denied صامت وتظهر "غير محدد" حتى لو
      // البيانات موجودة فعلاً وظاهرة عند الأدمن.
      allow read: if isOwner(parentId) || isAdmin() || isSupervisor();
      allow write: if isOwner(parentId) || isAdmin();
    }

    // System updates - علامة تحديث عامة (last_student_update وغيرها)
    // بيستخدمها التطبيق كإشارة "فيه تحديث جديد" عشان الشاشات تعمل
    // refresh، مفيهاش بيانات حساسة. كانت ناقصة القاعدة فكانت بتقع
    // تحت القاعدة الافتراضية اللي بتمنع كل شيء - وده كان بيسبب
    // permission-denied عند أي تحديث لحالة طالب.
    match /system_updates/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Absence requests - طلبات الغياب
    match /absences/{absenceId} {
      // الأدمن والمشرف يمكنهم إدارة طلبات الغياب
      allow read, write: if isAdmin() || isSupervisor();
      // ولي الأمر يمكنه إنشاء طلب غياب وقراءة طلباته
      allow create: if isParent() && isOwner(request.resource.data.parentId);
      allow read: if isParent() && isOwner(resource.data.parentId);
    }

    // Settings collection - إعدادات النظام
    match /settings/{settingId} {
      // الأدمن يمكنه إدارة جميع الإعدادات
      allow read, write: if isAdmin();
      // جميع المستخدمين يمكنهم قراءة الإعدادات العامة
      allow read: if isAuthenticated();
    }

    // Survey responses - إجابات الاستبيانات
    match /survey_responses/{responseId} {
      // الأدمن يمكنه قراءة جميع الإجابات
      allow read, write: if isAdmin();
      // المستخدم يمكنه إنشاء وقراءة إجاباته فقط
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Default rule - منع الوصول لأي مجموعة غير محددة
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
